# Copia este archivo a .env y ajusta los valores. Nunca versiones .env real.
DATABASE_URL=postgres://splitvision:splitvision@localhost:5432/splitvision
PORT=3000
IMAGE_DIR=./data/images
SESSION_SECRET=cambia-este-secreto
# OCR: fake (simulador) | local (Tesseract) | http (externo + fallback local)
OCR_PROVIDER=local
# Modo del cliente simulado: success | fail | timeout | corrupt | slow
FAKE_OCR_MODE=success
OCR_URL=
OCR_TIMEOUT_MS=10000
OCR_MAX_ATTEMPTS=4
OCR_BACKOFF_MS=2000,4000,8000
OCR_BREAKER_THRESHOLD=50
OCR_BREAKER_RESET_MS=30000
# OCR local (fallback cuando OCR_PROVIDER=http): local | none
OCR_FALLBACK=local
# Idiomas de Tesseract (p. ej. spa, spa+eng)
OCR_LANG=spa
# Directorio con los traineddata (vacío o inexistente => CDN de tesseract.js)
OCR_TESSDATA=./data/tessdata
OCR_CACHE_DIR=./data/tessdata-cache
SESSION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=10
JOB_POLL_MS=400
JOB_LEASE_S=60
MAX_UPLOAD_MB=5
