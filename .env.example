NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://splitvision:splitvision@localhost:5433/splitvision?schema=public
JWT_SECRET=cambia-este-secreto-largo-en-produccion-0123456789
JWT_EXPIRA=12h
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
LOG_LEVEL=info

# OCR: mock (deterministico para demo/tests) | tesseract (gratuito, sin API key)
OCR_PROVIDER=mock
OCR_TIMEOUT_MS=30000
OCR_MAX_RETRIES=2
OCR_MOCK_DELAY_MS=500
OCR_MOCK_ERROR_RATE=0
TESSERACT_LANG=spa+eng
